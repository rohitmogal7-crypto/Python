#recursion
def print_recursive(n):
    if n==0:
        return
    print(n)
    print_recursive(n-1)
    print("end")

print_recursive(5)

def fact_recursive(n):
     fact=1
     if n==0:
        return 1
     else:
         return n*fact_recursive(n-1)
     

print(fact_recursive(5))

def calc_sum(n):
    if n == 0:
        return 0
    else:
        return n + calc_sum(n-1)

print(calc_sum(5))
